# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible endpoint works: swap provider by changing these values only.

# --- Agent (system under test). Default: local Ollama. ---
AGENT_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key, but the OpenAI client requires a non-empty value.
AGENT_API_KEY=ollama
AGENT_MODEL=qwen3:8b

# --- Judge (must be stronger than the agent). Default: Google AI Studio. ---
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_API_KEY=replace-me
# Use the exact model id returned by the provider's /models endpoint.
JUDGE_MODEL=replace-me
